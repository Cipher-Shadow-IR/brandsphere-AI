# ---------------------------------------------------------------------
# BACKEND SERVICES & SECRETS (Python / FastAPI)
# Stored securely on server - NEVER EXPOSED TO CLIENT BROWSER
# ---------------------------------------------------------------------
DATABASE_URL=sqlite:///./brand_governance.db
# DATABASE_URL=postgresql://user:password@ep-sample.neon.tech/brandsphere?sslmode=require

GEMINI_API_KEY=your_gemini_api_key_here

# QDRANT_URL=https://your-cluster-id.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_STORAGE_PATH=./qdrant_storage

# REDIS_URL=rediss://default:token@your-redis.upstash.io:6379

CORS_ORIGINS=
VERIFICATION_BASE_URL=

# ---------------------------------------------------------------------
# FRONTEND PUBLIC CONFIGURATION (Next.js)
# Client-side safe URL pointing to backend API
# ---------------------------------------------------------------------
API_URL=

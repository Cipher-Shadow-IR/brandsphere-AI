# =====================================================================
# BrandSphere AI Backend Environment Configuration (.env)
# SECRETS AND SENSITIVE CREDENTIALS - NEVER EXPOSED TO FRONTEND
# =====================================================================

# ---------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / SQLite)
# ---------------------------------------------------------------------
# For Production (Neon, Supabase, AWS RDS PostgreSQL):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/brandsphere?sslmode=require
# For Local Development (Default fallback if omitted):
DATABASE_URL=sqlite:///./brand_governance.db

# ---------------------------------------------------------------------
# 2. MULTIMODAL LLM (Google Gemini 1.5 Flash)
# ---------------------------------------------------------------------
# Get your API key from Google AI Studio (https://aistudio.google.com/):
# Required for context-preserving auto-remediation and multimodal creative auditing.
# If omitted, system gracefully falls back to deterministic rule-based engine and Pillow CV.
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------
# 3. VECTOR DATABASE (Qdrant Cloud or Local Embedded)
# ---------------------------------------------------------------------
# For Qdrant Cloud (Managed cluster):
# QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
# If omitted, system automatically initializes embedded local Qdrant (./qdrant_storage or in-memory)
QDRANT_STORAGE_PATH=./qdrant_storage

# ---------------------------------------------------------------------
# 4. HIGH-SPEED DISTRIBUTED CACHE (Redis / Upstash)
# ---------------------------------------------------------------------
# For Production (Upstash Redis or Redis Cloud with TLS):
# REDIS_URL=rediss://default:your_token@your-redis-instance.upstash.io:6379
# If omitted or unreachable, system automatically falls back to in-memory TTL dictionary cache
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------
# 5. CORS ORIGINS (Allowed frontend domains)
# ---------------------------------------------------------------------
CORS_ORIGINS=
VERIFICATION_BASE_URL=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001
